# ---------------------------------------------------------------------------
# Resource profile of the cluster (read by docker-compose.yml)
#
# Every YARN container has the same size, whatever runs inside it:
# a MapReduce map/reduce task, a Spark executor (1 core), or an
# ApplicationMaster.  Each of the 2 NodeManagers offers
# CONTAINER_MB * CONTAINERS_PER_WORKER MB, so the cluster runs
# 2 * CONTAINERS_PER_WORKER containers at once: 1 ApplicationMaster and
# 2 * CONTAINERS_PER_WORKER - 1 parallel tasks / executors.
#
#   Memory available to Docker   CONTAINERS_PER_WORKER   parallel tasks
#   ~8 GB  (16 GB laptop)                 2                     3
#   ~12 GB                                3                     5
#   ~16 GB or more                        4                     7
#
# CONTAINER_MB must be >= 1024 (Spark needs >= 450 MB of executor heap).
# After changing these values run:  docker compose up -d --force-recreate
# ---------------------------------------------------------------------------
CONTAINER_MB=1024
CONTAINERS_PER_WORKER=2
